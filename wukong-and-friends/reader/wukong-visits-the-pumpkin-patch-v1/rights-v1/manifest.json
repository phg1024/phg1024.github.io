      ]
    },
    {
      "image": "page-18.webp",
      "width": 1224,
      "height": 1584,
      "sha256": "f7318e565a2833c0d464ae9def6e58c4260501182b0c19787807e620c90a92ae",
      "text": "Wukong & Friends\nTurn left at the scarecrow.\nTurn right at the pumpkins.\nWhich way will you go?\nphg1024.github.io/wukong-and-friends",
