    },
    {
      "image": "page-18.webp",
      "width": 1224,
      "height": 1584,
      "sha256": "d05f2b636b0646a143b0d55e08f934049074cd380a123fad39387ffe14bc3a72",
      "text": "Wukong & Friends\nBlock the light,\nand a shadow appears.\nNearer is bigger!\nphg1024.github.io/wukong-and-friends",
