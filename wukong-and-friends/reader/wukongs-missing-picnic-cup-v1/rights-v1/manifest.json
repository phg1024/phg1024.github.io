    },
    {
      "image": "page-18.webp",
      "width": 1224,
      "height": 1584,
      "sha256": "076768698e07e529585a97c24119c968123876af88a92554bd31848aa8bd4db4",
      "text": "Wukong & Friends\nCount your friends.\nCount yourself, too!\nThen everyone gets a cup.\nphg1024.github.io/wukong-and-friends",
