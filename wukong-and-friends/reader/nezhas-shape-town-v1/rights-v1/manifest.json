    },
    {
      "image": "page-18.webp",
      "width": 1224,
      "height": 1584,
      "sha256": "36d5bbd422b1d69b8ca5d68c3db37302b34755f4ce3d367f27230cc338a9c866",
      "text": "Wukong & Friends\nTurn them around.\nPut them together.\nWhat shape can you make?\nphg1024.github.io/wukong-and-friends",
