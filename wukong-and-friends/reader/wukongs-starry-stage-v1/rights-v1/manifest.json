    },
    {
      "image": "page-18.webp",
      "width": 1224,
      "height": 1584,
      "sha256": "751ffcbb2c4c7a8eca877fc2703d736d5c58a3e3342adfc8b5f92591890614df",
      "text": "Wukong & Friends\nSix and two make eight.\nTake away three: five are left.\nStill eight altogether!\nphg1024.github.io/wukong-and-friends",
