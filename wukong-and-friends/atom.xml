    <atom:id>https://phg1024.github.io/wukong-and-friends/books/wukong-learns-to-swim/</atom:id>
    <atom:title type="text">Wukong Learns to Swim</atom:title>
    <atom:link href="https://phg1024.github.io/wukong-and-friends/books/wukong-learns-to-swim/" rel="alternate" type="text/html" hreflang="en" />
    <atom:published>2026-10-23T00:00:00Z</atom:published>
    <atom:updated>2026-10-23T00:00:00Z</atom:updated>
    <atom:author>
      <atom:name>Peihong Guo</atom:name>
      <atom:uri>https://phg1024.github.io/wukong-and-friends/</atom:uri>
    </atom:author>
    <atom:summary type="html">&lt;p&gt;Wukong is curious about swimming, but the pool feels big. With Coach Otter nearby and Ao Bing cheering him on, he practices bubbles, floating, and kicks until he swims a little way on his own.&lt;/p&gt;&lt;p&gt;&lt;a href="https://phg1024.github.io/wukong-and-friends/covers/wukong-learns-to-swim-v1.jpg"&gt;&lt;img src="https://phg1024.github.io/wukong-and-friends/covers/wukong-learns-to-swim-v1.jpg" alt="Wukong Learns to Swim" /&gt;&lt;/a&gt;&lt;/p&gt;</atom:summary>
  </atom:entry>
  <atom:entry xml:lang="en">
    <atom:id>https://phg1024.github.io/wukong-and-friends/books/wukongs-first-ballet-class/</atom:id>
    <atom:title type="text">Jade Rabbit’s First Ballet Class</atom:title>
    <atom:link href="https://phg1024.github.io/wukong-and-friends/books/wukongs-first-ballet-class/" rel="alternate" type="text/html" hreflang="en" />
    <atom:published>2026-10-23T00:00:00Z</atom:published>
    <atom:updated>2026-10-23T00:00:00Z</atom:updated>
    <atom:author>
      <atom:name>Peihong Guo</atom:name>
      <atom:uri>https://phg1024.github.io/wukong-and-friends/</atom:uri>
    </atom:author>
    <atom:summary type="html">&lt;p&gt;Jade Rabbit’s first ballet class is full of tiny steps, a playful turn, and wobbly ears. With Chang’e beside her, Jade finds the beat and takes a happy bow.&lt;/p&gt;&lt;p&gt;&lt;a href="https://phg1024.github.io/wukong-and-friends/covers/wukongs-first-ballet-class-v1.jpg"&gt;&lt;img src="https://phg1024.github.io/wukong-and-friends/covers/wukongs-first-ballet-class-v1.jpg" alt="Jade Rabbit’s First Ballet Class" /&gt;&lt;/a&gt;&lt;/p&gt;</atom:summary>
  </atom:entry>
  <atom:entry xml:lang="en">
    <atom:id>https://phg1024.github.io/wukong-and-friends/books/wukong-plays-in-the-sand/</atom:id>
    <atom:title type="text">Wukong Plays in the Sand</atom:title>
    <atom:link href="https://phg1024.github.io/wukong-and-friends/books/wukong-plays-in-the-sand/" rel="alternate" type="text/html" hreflang="en" />
    <atom:published>2026-10-22T00:00:00Z</atom:published>
    <atom:updated>2026-10-22T00:00:00Z</atom:updated>
    <atom:author>
      <atom:name>Peihong Guo</atom:name>
      <atom:uri>https://phg1024.github.io/wukong-and-friends/</atom:uri>
    </atom:author>
    <atom:summary type="html">&lt;p&gt;Wukong and his friends try dry sand, then add too much water. They adjust the mix and build a sand tower together. At the end, Wukong finds a little mountain in his shoe.&lt;/p&gt;&lt;p&gt;&lt;a href="https://phg1024.github.io/wukong-and-friends/covers/wukong-plays-in-the-sand-v2.jpg"&gt;&lt;img src="https://phg1024.github.io/wukong-and-friends/covers/wukong-plays-in-the-sand-v2.jpg" alt="Wukong Plays in the Sand" /&gt;&lt;/a&gt;&lt;/p&gt;</atom:summary>
  </atom:entry>
  <atom:entry xml:lang="en">
    <atom:id>https://phg1024.github.io/wukong-and-friends/books/wukongs-painting-class/</atom:id>
    <atom:title type="text">Wukong’s Painting Class</atom:title>
    <atom:link href="https://phg1024.github.io/wukong-and-friends/books/wukongs-painting-class/" rel="alternate" type="text/html" hreflang="en" />
    <atom:published>2026-10-22T00:00:00Z</atom:published>
    <atom:updated>2026-10-22T00:00:00Z</atom:updated>
    <atom:author>
      <atom:name>Peihong Guo</atom:name>
      <atom:uri>https://phg1024.github.io/wukong-and-friends/</atom:uri>
    </atom:author>
    <atom:summary type="html">&lt;p&gt;Wukong turns a brown paint blob into a little bear. Nezha paints a rainbow unicorn, Pigsy paints a bunny, and together they make one happy picture.&lt;/p&gt;&lt;p&gt;&lt;a href="https://phg1024.github.io/wukong-and-friends/covers/wukongs-painting-class-v2.jpg"&gt;&lt;img src="https://phg1024.github.io/wukong-and-friends/covers/wukongs-painting-class-v2.jpg" alt="Wukong’s Painting Class" /&gt;&lt;/a&gt;&lt;/p&gt;</atom:summary>
  </atom:entry>
  <atom:entry xml:lang="en">
    <atom:id>https://phg1024.github.io/wukong-and-friends/books/wukong-and-the-snowy-zigzags/</atom:id>
    <atom:title type="text">Wukong and the Snowy Zigzags</atom:title>
    <atom:link href="https://phg1024.github.io/wukong-and-friends/books/wukong-and-the-snowy-zigzags/" rel="alternate" type="text/html" hreflang="en" />
    <atom:published>2026-10-20T00:00:00Z</atom:published>
    <atom:updated>2026-10-22T00:00:00Z</atom:updated>
    <atom:author>
      <atom:name>Peihong Guo</atom:name>
      <atom:uri>https://phg1024.github.io/wukong-and-friends/</atom:uri>
    </atom:author>
    <atom:summary type="html">&lt;p&gt;Wukong and Princess Iron Fan learn to ski, one snowy zigzag at a time. Jade Rabbit cheers them on, and warm cocoa and fish crackers make a happy finish.&lt;/p&gt;&lt;p&gt;&lt;a href="https://phg1024.github.io/wukong-and-friends/covers/wukong-and-the-snowy-zigzags-cover-v5.jpg"&gt;&lt;img src="https://phg1024.github.io/wukong-and-friends/covers/wukong-and-the-snowy-zigzags-cover-v5.jpg" alt="Wukong and the Snowy Zigzags" /&gt;&lt;/a&gt;&lt;/p&gt;</atom:summary>
  </atom:entry>
  <atom:entry xml:lang="en">
    <atom:id>https://phg1024.github.io/wukong-and-friends/books/wukong-and-the-tiny-tomatoes/</atom:id>
    <atom:title type="text">Wukong and the Tiny Tomatoes</atom:title>
    <atom:link href="https://phg1024.github.io/wukong-and-friends/books/wukong-and-the-tiny-tomatoes/" rel="alternate" type="text/html" hreflang="en" />
    <atom:published>2026-10-20T00:00:00Z</atom:published>
    <atom:updated>2026-10-22T00:00:00Z</atom:updated>
    <atom:author>
      <atom:name>Peihong Guo</atom:name>
      <atom:uri>https://phg1024.github.io/wukong-and-friends/</atom:uri>
    </atom:author>
    <atom:summary type="html">&lt;p&gt;Wukong and Ao Bing plant tiny tomatoes, water them, and wait. A little rain magic helps; patience brings a sweet harvest to share.&lt;/p&gt;&lt;p&gt;&lt;a href="https://phg1024.github.io/wukong-and-friends/covers/wukong-and-the-tiny-tomatoes-v2.jpg"&gt;&lt;img src="https://phg1024.github.io/wukong-and-friends/covers/wukong-and-the-tiny-tomatoes-v2.jpg" alt="Wukong and the Tiny Tomatoes" /&gt;&lt;/a&gt;&lt;/p&gt;</atom:summary>
  </atom:entry>
  <atom:entry xml:lang="en">
    <atom:id>https://phg1024.github.io/wukong-and-friends/books/wukong-and-the-big-red-truck/</atom:id>
    <atom:title type="text">Wukong and the Big Red Truck</atom:title>
    <atom:link href="https://phg1024.github.io/wukong-and-friends/books/wukong-and-the-big-red-truck/" rel="alternate" type="text/html" hreflang="en" />
    <atom:published>2026-10-19T00:00:00Z</atom:published>
    <atom:updated>2026-10-22T00:00:00Z</atom:updated>
    <atom:author>
      <atom:name>Peihong Guo</atom:name>
      <atom:uri>https://phg1024.github.io/wukong-and-friends/</atom:uri>
    </atom:author>
    <atom:summary type="html">&lt;p&gt;Join Firefighter Ben to discover a very exciting big red truck.&lt;/p&gt;&lt;p&gt;&lt;a href="https://phg1024.github.io/wukong-and-friends/covers/wukong-and-the-big-red-truck-v5.jpg"&gt;&lt;img src="https://phg1024.github.io/wukong-and-friends/covers/wukong-and-the-big-red-truck-v5.jpg" alt="Wukong and the Big Red Truck" /&gt;&lt;/a&gt;&lt;/p&gt;</atom:summary>
  </atom:entry>
