    <atom:title type="text">Sun Wukong’s One Little Bite</atom:title>
    <atom:link href="https://phg1024.github.io/wukong-and-friends/books/wukongs-one-little-bite/" rel="alternate" type="text/html" hreflang="en" />
    <atom:published>2026-10-19T00:00:00Z</atom:published>
    <atom:updated>2026-10-22T00:00:00Z</atom:updated>
    <atom:author>
      <atom:name>Peihong Guo</atom:name>
      <atom:uri>https://phg1024.github.io/wukong-and-friends/</atom:uri>
    </atom:author>
    <atom:summary type="html">&lt;p&gt;One tiny taste leads Wukong toward a warm, friendly supper.&lt;/p&gt;&lt;p&gt;&lt;a href="https://phg1024.github.io/wukong-and-friends/covers/wukongs-one-little-bite-v5.jpg"&gt;&lt;img src="https://phg1024.github.io/wukong-and-friends/covers/wukongs-one-little-bite-v5.jpg" alt="Sun Wukong’s One Little Bite" /&gt;&lt;/a&gt;&lt;/p&gt;</atom:summary>
  </atom:entry>
  <atom:entry xml:lang="en">
