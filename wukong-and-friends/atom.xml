    <atom:author>
      <atom:name>Peihong Guo</atom:name>
      <atom:uri>https://phg1024.github.io/wukong-and-friends/</atom:uri>
    </atom:author>
    <atom:summary type="html">&lt;p&gt;His feet feel like tiny sleds. A little tumble, then one more try!&lt;/p&gt;&lt;p&gt;&lt;a href="https://phg1024.github.io/wukong-and-friends/covers/wukongs-slippy-slide-skates-v5.jpg"&gt;&lt;img src="https://phg1024.github.io/wukong-and-friends/covers/wukongs-slippy-slide-skates-v5.jpg" alt="Wukong’s Slippy-Slide Skates" /&gt;&lt;/a&gt;&lt;/p&gt;</atom:summary>
  </atom:entry>
